# ==============================================================
# KONFIGURASI SISTEM MENU MBG - Salin file ini menjadi .env
# lalu sesuaikan nilainya sebelum menjalankan di VPS/produksi.
# ==============================================================

# --------------------------------------------------------------
# [WAJIB] Domain publik untuk QR permanen.
# Isi dengan domain HTTPS tetap Anda (tanpa garis miring di akhir).
# QR akan dibuat ulang otomatis saat nilai ini berubah.
# --------------------------------------------------------------
MBG_PUBLIC_URL=https://mbg-babussalam.my.id

# --------------------------------------------------------------
# [WAJIB] Password login halaman Admin (/admin).
# Ganti dengan password yang kuat sebelum deploy!
# --------------------------------------------------------------
ADMIN_PASSWORD=ganti_dengan_password_kuat_anda

# --------------------------------------------------------------
# [WAJIB] Secret key untuk keamanan session Flask.
# Isi dengan string acak yang panjang dan tidak mudah ditebak.
# Contoh: jalankan di terminal Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
# lalu tempelkan hasilnya di sini.
# --------------------------------------------------------------
SECRET_KEY=ganti_dengan_string_acak_panjang_minimal_32_karakter

# --------------------------------------------------------------
# [OPSIONAL] Mode debug Flask.
# Isi "True" hanya saat pengembangan lokal, JANGAN di produksi!
# Biarkan kosong atau "False" untuk VPS/produksi.
# --------------------------------------------------------------
FLASK_DEBUG=False
